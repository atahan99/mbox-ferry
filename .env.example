SOURCE_FOLDER=
DESTINATION_FOLDER=Folders/Imported Mail
BRIDGE_USERNAME=
BRIDGE_PASSWORD=

# Used when a malformed From header has no configured Sent-folder rule.
FALLBACK_SENDER_EMAIL=unknown@invalid.local

# Optional Sent-folder rule. Leave all three blank to disable it.
# Messages before the cutoff use BEFORE; messages on/after it use AFTER.
SENT_FROM_CUTOFF=
SENT_FROM_BEFORE_EMAIL=
SENT_FROM_AFTER_EMAIL=
